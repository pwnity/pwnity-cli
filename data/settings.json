{
    "notifications": {
        "enableDesktop": false,
        "enableThreading": true,
        "mutePopups": false,
        "timeout": 5000
    },
    "terminal": {
        "fontSize": 14,
        "fontFamily": "JetBrains Mono, monospace",
        "theme": "dracula",
        "copyOnSelect": true,
        "cursorBlink": true,
        "scrollback": 5000,
        "startupBehavior": "docked",
        "shells": [
            {
                "name": "BASH",
                "path": "/bin/bash"
            },
            {
                "name": "ZSH",
                "path": "/bin/zsh"
            },
            {
                "name": "SH",
                "path": "/bin/sh"
            },
            {
                "name": "PYTHON",
                "path": "/usr/bin/python3"
            },
            {
                "name": "PHP",
                "path": "/usr/bin/php -a"
            }
        ]
    },
    "cli": {
        "autoSaveInterval": 30,
        "defaultWordlist": "",
        "defaultThreads": 10,
        "historyLimit": 1000,
        "autoConnect": true
    },
    "ui": {
        "highContrast": false,
        "reducedMotion": false
    }
}