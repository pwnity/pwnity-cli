{
    "notifications": {
        "enableDesktop": true,
        "enableThreading": true,
        "mutePopups": true,
        "timeout": 5000
    },
    "terminal": {
        "fontSize": 14,
        "fontFamily": "JetBrains Mono, monospace",
        "theme": "dracula",
        "copyOnSelect": true,
        "cursorBlink": true,
        "scrollback": 5000,
        "startupBehavior": "closed",
        "shells": [
            {
                "name": "BASH",
                "path": "/bin/bash",
                "protected": true
            },
            {
                "name": "ZSH",
                "path": "/bin/zsh",
                "protected": true
            },
            {
                "name": "SH",
                "path": "/bin/sh",
                "protected": true
            },
            {
                "name": "PYTHON",
                "path": "/usr/bin/python3",
                "protected": true
            },
            {
                "name": "PHP",
                "path": "/usr/bin/php -a"
            },
            {
                "name": "METASPLOIT",
                "path": "msfconsole -q"
            },
            {
                "name": "RECON-NG",
                "path": "recon-ng"
            },
            {
                "name": "REV-4444",
                "path": "nc -lvnp 4444"
            }
        ]
    },
    "cli": {
        "autoSaveInterval": 30,
        "defaultWordlist": "",
        "historyLimit": 1000,
        "autoConnect": true,
        "defaultThreads": 10
    },
    "ui": {
        "highContrast": false,
        "reducedMotion": false
    }
}