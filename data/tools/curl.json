{
  "path": "/usr/bin/curl",
  "sudo": false,
  "name": "curl",
  "commands": [
    {
      "name": "bannergrab",
      "params": [
        "-s",
        "-D -",
        "-o /dev/null",
        "$target.base_url"
      ]
    },
    {
      "name": "head",
      "params": [
        "-I",
        "-s",
        "-A $profile.useragent",
        "-k",
        "$target.base_url"
      ]
    }
  ]
}