{
    "name": "hub/127_0_0_1_8000/gobuster_dir_scan_artifacts",
    "description": "Regex patterns for parsing gobuster dir scan outputs.",
    "rules": [
        {
            "name": "directory",
            "regex": "(/[^ ]+)\\s+\\(Status:\\s*(?:1\\d{2}|2\\d{2}|3\\d{2})\\)"
        },
        {
            "name": "status_code",
            "regex": "\\(Status:\\s*(\\d{3})\\)"
        },
        {
            "name": "size",
            "regex": "\\[Size:\\s*(\\d+)\\]"
        },
        {
            "name": "content_type",
            "regex": "\\[Content-Type:\\s*([\\w/-]+)\\]"
        },
        {
            "name": "redirect",
            "regex": "\\[-->\\s*(\\S+)\\]"
        }
    ],
    "hub_id": "98f1323e-496f-43ba-93db-ef0c8d757400",
    "hub_origin": "http://127.0.0.1:8000"
}